{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "verifyReleaseCmd": "echo ${nextRelease.version} > .next-version && { [ -z \"$PLANNED_VERSION\" ] || [ \"$PLANNED_VERSION\" = \"${nextRelease.version}\" ]; }"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [{ "path": "dist/*" }],
        "successComment": false,
        "failComment": false,
        "releasedLabels": false
      }
    ]
  ]
}
